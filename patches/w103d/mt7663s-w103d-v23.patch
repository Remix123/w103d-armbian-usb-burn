+/* The MT7663 V3 offload firmware only programs the own MAC address (OMAC)
+ * of a BSS from the unified DEV_INFO command; mt7615 uses it for this
+ * firmware in uni_update_ops (mt76_connac_mcu_uni_add_dev()).  The extended
+ * DEV_INFO_UPDATE sent by the legacy W103D path is accepted but leaves OMAC
+ * unset: the MAC never treats frames to our address as unicast-to-me, so it
+ * neither ACKs them nor recognizes the AP's ACKs.  The AP then retransmits
+ * every unicast frame (EAPOL M1/M3, DHCP replies) until its retry limit,
+ * 2.4 GHz traffic (no A-MPDU from the AP) stalls for seconds after each
+ * connect, and every TXS reports ACK_TIMEOUT.  Send the unified request as
+ * well; like the other UNI SET commands it is fire-and-forget here.
+ */
+static int mt7663s_w103d_uni_dev_info(struct mt7615_phy *phy,
+				      struct ieee80211_vif *vif, bool enable)
+{
+	struct mt7615_vif *mvif = (struct mt7615_vif *)vif->drv_priv;
+	struct {
+		struct {
+			u8 omac_idx;
+			u8 band_idx;
+			__le16 pad;
+		} __packed hdr;
+		struct {
+			__le16 tag;
+			__le16 len;
+			u8 active;
+			u8 link_idx;
+			u8 omac_addr[ETH_ALEN];
+		} __packed tlv;
+	} __packed req = {
+		.hdr = {
+			.omac_idx = mvif->mt76.omac_idx,
+			.band_idx = mvif->mt76.band_idx,
+		},
+		.tlv = {
+			.tag = cpu_to_le16(DEV_INFO_ACTIVE),
+			.len = cpu_to_le16(sizeof(req.tlv)),
+			.active = enable,
+			.link_idx = mvif->mt76.link_idx,
+		},
+	};
+
+	memcpy(req.tlv.omac_addr, vif->addr, ETH_ALEN);
+	return mt76_mcu_send_msg(&phy->dev->mt76, MCU_UNI_CMD(DEV_INFO_UPDATE),
+				 &req, sizeof(req), true);
+}
